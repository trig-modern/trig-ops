# Copy to .env and fill in. .env is gitignored — the service key NEVER goes in the repo.
SUPABASE_URL=https://xyfogedlowneaevmjkci.supabase.co
SUPABASE_SERVICE_KEY=paste_service_role_key_here   # Supabase > Settings > API > service_role
PRINTER_QUEUE=Brother_QL_800                        # exact CUPS queue name (lpstat -p)
POLL_SECONDS=8
LABEL_W_MM=62                                       # DK-2205 continuous width
LABEL_H_MM=45                                       # cut length
DPI=300
DELIVERY_APP_URL=https://trig-delivery.netlify.app
# LP_MEDIA=Custom.62x45mm                           # uncomment/adjust if your Brother driver needs an explicit media size
